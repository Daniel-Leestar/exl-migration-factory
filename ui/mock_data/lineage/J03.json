{
  "job": "J03",
  "method": "ir",
  "confidence": "derived",
  "tables": [
    "claims",
    "policy"
  ],
  "outputs": {
    "IDpol": {
      "sources": [
        "policy.IDpol"
      ],
      "expression": "p.IDpol",
      "operations": []
    },
    "Region": {
      "sources": [
        "policy.Region"
      ],
      "expression": "p.Region",
      "operations": []
    },
    "TotalClaim": {
      "sources": [
        "claims.ClaimAmount"
      ],
      "expression": "ISNULL(SUM(c.ClaimAmount), 0)",
      "operations": [
        "aggregate:SUM",
        "function:ISNULL"
      ]
    },
    "ClaimCount": {
      "sources": [
        "claims.IDpol"
      ],
      "expression": "COUNT(c.IDpol)",
      "operations": [
        "aggregate:COUNT"
      ]
    }
  },
  "row_filters": [
    "claims.IDpol",
    "policy.IDpol"
  ],
  "group_by": [
    "policy.IDpol",
    "policy.Region"
  ]
}