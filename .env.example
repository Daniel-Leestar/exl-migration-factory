# Local settings (not committed). 本機設定(不提交)。
MF_SQLSERVER_CONN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=(localdb)\MSSQLLocalDB;Trusted_Connection=yes;
MF_OLLAMA_MODEL=qwen2.5-coder:3b
# Address of the model server. Change it to use an Ollama server on another machine.
# 模型伺服器位址;要改用其他機器上的 Ollama 時修改這裡。
MF_OLLAMA_HOST=http://localhost:11434
# Folder holding the raw / bronze / silver / quarantine / gold layers.
# 存放 raw / bronze / silver / quarantine / gold 各層的資料夾。
MF_LAKEHOUSE_ROOT=data
